# ============================================================
# 旭日云课堂 · 运行环境变量模板
#
# 安装器会把本文件复制为 <安装目录>/app.env（默认 /opt/xuri-classroom/app.env），
# 写入实际取值后设为 0600，只有运行用户可以读取。
# 修改后执行：systemctl restart xuri-classroom
#
# 取值统一用单引号包裹；systemd 与 bash 都会去掉这层引号。
# 取值不要包含：单引号、反斜杠、换行（systemd 的 EnvironmentFile 会处理转义，
# 无法保证原样传递）。这类特殊密码请在安装后按 systemd 规则手工编辑。
# ============================================================

# ---------- 数据库 ----------
DB_HOST='127.0.0.1'
DB_PORT='3306'
DB_NAME='surveyking'
DB_USER='surveyking'
DB_PASSWORD='change-me'

# ---------- 服务 ----------
# 对外端口；systemd 直接读取，改完重启服务即可
SERVER_PORT='8080'
# 时区（影响日志时间）
TZ='Asia/Shanghai'
# JVM 参数：4GB 内存机器建议 -Xmx768m；8GB 建议 -Xmx1536m
JAVA_TOOL_OPTIONS='-Xmx768m'

# ---------- 安全 ----------
# JWT 签名密钥：安装器用 openssl rand -base64 48 生成并保留。
# 修改后所有人需要重新登录；多实例部署必须一致。
SK_JWT_SECRET=''
# 由后端托管前端 SPA（发布 jar 内已打包前端静态资源）。
# 如果前端由 nginx/CDN 单独提供，可改为 false。
SK_WEB_SPA_ENABLED='true'

# ---------- 文件存储 ----------
# 上传的图片/附件落盘目录；安装器会改成 <安装目录>/files 并授权给运行用户
FILE_STORAGE_LOCAL_ROOT_PATH='/opt/xuri-classroom/files'

# ---------- 数据源（供 pro 配置包的 jar 使用）----------
# dev 配置包的 jar 直接读取上面的 DB_*；pro 配置包不含 application-dev.yml，
# 必须靠下面三个变量。安装器会按 DB_* 自动同步这三项，通常不用手改。
# 注意 useSSL=false：JDK8 的 MySQL connector 与 MySQL 8 的 TLS 握手会失败。
SPRING_DATASOURCE_URL='jdbc:mysql://127.0.0.1:3306/surveyking?rewriteBatchedStatements=true&useUnicode=true&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai'
SPRING_DATASOURCE_USERNAME='surveyking'
SPRING_DATASOURCE_PASSWORD='change-me'
