# 旭日云课堂 · Windows 便携版 运行时组件下载源（示例）
# 首次 setup 会自动生成 config\runtime.env，内容与本示例相同。
# 想换源只改 config\runtime.env，不用改脚本；改完重跑 setup.cmd。
# 下载的文件放在 cache\，校验通过后会复用；--offline 表示只用 cache 里已有的文件。

# 内置 MySQL 端口（只监听 127.0.0.1；必须与 config\app.env 的 DB_PORT 一致）
MYSQL_PORT=3307

# ---- JRE（OpenJDK 8 JRE / Temurin 8u512b09，Windows x64，约 38 MB）----
# 优先清华 TUNA，失败自动换南京大学；两个都是同一份官方构建的镜像。
JRE_VERSION=8u512b09
JRE_URLS=https://mirrors.tuna.tsinghua.edu.cn/Adoptium/8/jre/x64/windows/OpenJDK8U-jre_x64_windows_hotspot_8u512b09.zip;https://mirrors.nju.edu.cn/adoptium/8/jre/x64/windows/OpenJDK8U-jre_x64_windows_hotspot_8u512b09.zip
# SHA256 来自 Adoptium 官方发布页（大小只作展示，校验以 SHA256 为准）
JRE_SHA256=ae1ae12f817d7735477c6555107eece73854da0654da69077309ef9bff0b78bf
JRE_SIZE=40124908

# ---- MySQL 8.0（Windows x64 zip）----
# 格式：地址|版本|SHA256|字节数。按顺序尝试，失败自动换下一个源。
# 1) 国内镜像 8.0.28：约 212 MB，速度快（推荐）
# 2) 官方 8.0.44：约 233 MB，国内下载可能很慢，仅当前两个源都失败时才用
# 没有填 SHA256 的源会被自动跳过（不下载未校验的文件）；不想用某个源就在行首加 #。
MYSQL_MIRRORS=https://mirrors.huaweicloud.com/mysql/Downloads/MySQL-8.0/mysql-8.0.28-winx64.zip|8.0.28|cb207afb33e2bbfe9535ba78fa9a1a3cccd11156f73864a5db0be8dcc2dbb1bc|222021254
MYSQL_MIRRORS=https://mirrors.aliyun.com/mysql/MySQL-8.0/mysql-8.0.28-winx64.zip|8.0.28|cb207afb33e2bbfe9535ba78fa9a1a3cccd11156f73864a5db0be8dcc2dbb1bc|222021254
MYSQL_MIRRORS=https://cdn.mysql.com/Downloads/MySQL-8.0/mysql-8.0.44-winx64.zip|8.0.44|4d9316d2955b0bd2b484e08bda67c18d7979e0622b84f2e9146d97f04ed9a2fc|244529072
