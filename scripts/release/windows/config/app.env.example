# ============================================================
# 旭日云课堂 · Windows 便携版 应用配置（示例）
#
# 首次运行会自动生成 config\app.env，内容与本示例相同，只是
# DB_PASSWORD / DB_ROOT_PASSWORD / SK_JWT_SECRET 是随机值。
# 要改配置请改 config\app.env，不要改这个示例文件。
# 本文件含口令，不要发群、不要提交到代码仓库。
# ============================================================

# 网站端口（局域网访问：http://本机IP:PORT）
PORT=8080

# 内置 MySQL 只监听 127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=surveyking
DB_USER=xuri
DB_PASSWORD=（首次运行随机生成 32 位十六进制）
DB_ROOT_PASSWORD=（首次运行随机生成 32 位十六进制）

# 登录令牌签名密钥（首次运行随机生成，Base64 48 字节）
SK_JWT_SECRET=（首次运行随机生成）

# JVM 参数；内存小的机器可以改成 -Xmx768m
JAVA_OPTS=-Xmx1024m

# 附件与导出文件目录（相对路径按包根目录解析）
FILE_STORAGE_ROOT=data\files
