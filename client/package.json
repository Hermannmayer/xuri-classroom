{
  "name": "surveyking-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test:rules": "esbuild scripts/test-rules.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-rules.mjs --log-level=warning && node node_modules/.cache/test-rules.mjs",
    "test:tree": "esbuild scripts/test-tree.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-tree.mjs --log-level=warning && node node_modules/.cache/test-tree.mjs",
    "test:login": "node scripts/smoke-login.cjs http://127.0.0.1:80 admin 123456"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/crypto-js": "^4.2.2",
    "antd": "^5.22.5",
    "crypto-js": "^4.1.1",
    "dayjs": "^1.11.13",
    "dompurify": "^3.4.17",
    "jsencrypt": "^3.3.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
