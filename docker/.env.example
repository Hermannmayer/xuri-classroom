# ============================================================
# 旭日云课堂 · Docker 发布环境变量
# 复制为 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取同目录的 .env
# ============================================================

# 对外端口
APP_PORT=8080

# ---------- 数据库 ----------
# db 容器初始化时生效；MYSQL_ROOT_PASSWORD 与应用账号共用这个密码
DB_NAME=surveyking
# 注意：mysql 官方镜像不允许 MYSQL_USER=root，这里保持非 root 账号
DB_USER=xuri
DB_PASSWORD=change-me

# ---------- 安全 ----------
# JWT 签名密钥，生成：openssl rand -base64 48
JWT_SECRET=change-me

# ---------- 镜像 ----------
# GHCR tag，不带 v；生产环境建议固定版本（例如 2.0.0），方便回滚
VERSION=latest

# 可选：镜像名（不含 tag），用于国内镜像源，例如：
# XURI_IMAGE=ghcr.nju.edu.cn/hermannmayer/xuri-classroom
# XURI_IMAGE=ghcr.io/hermannmayer/xuri-classroom

# 可选：init-mysql.sql 路径（默认 ./init-mysql.sql，仅首次空库启动时执行）
# INIT_SQL_FILE=./init-mysql.sql

# 可选：JVM 堆上限（4GB 内存用 -Xmx768m，8GB 可用 -Xmx1536m）
# JAVA_OPTS=-Xmx768m
