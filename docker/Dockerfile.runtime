# 旭日云课堂 · 运行时镜像
FROM eclipse-temurin:25-jre-jammy






RUN apt-get update \
    && apt-get install -y --no-install-recommends tzdata curl fontconfig libfreetype6 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && ln -snf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone

WORKDIR /app


ENV TZ=Asia/Shanghai \
    SK_WEB_SPA_ENABLED=true \
    FILE_STORAGE_LOCAL_ROOT_PATH=/app/files


ARG JAR_FILE=xuri-classroom.jar
COPY ${JAR_FILE} /app/app.jar

RUN mkdir -p /app/files

EXPOSE 8080


HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=5 \
  CMD curl -fsS http://127.0.0.1:8080/api/system >/dev/null || exit 1


ENTRYPOINT ["java", "-Djava.awt.headless=true", "-jar", "/app/app.jar", "--server.port=8080"]