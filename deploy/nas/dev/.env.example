# =============================================================================
# 旭日云课堂 · NAS 开发环境变量模板
#
# 使用方法（在 NAS 上、deploy/nas/dev/ 目录内）：
#   cp .env.example .env
#   # 按需修改下面的值，然后：
#   bash bootstrap.sh
#
# bootstrap.sh 发现没有 .env 时会自动帮你 cp 一份，所以也可以直接跑它。
# .env 已被仓库根目录的 .gitignore 忽略，数据库密码不会进 git。
# 注意：这些变量全部是小写字母+下划线风格的大写键名，值不要加引号、不要带空格。
# =============================================================================

# 源码在 NAS 上的绝对路径（bind mount 到容器内 /workspace）。
# 必须是绝对路径；建议放在数据盘 /vol2，别放系统盘。
# bootstrap.sh 会自动创建这个目录（以及同级的 backup/）。
DEV_SRC=/vol2/1000/xuri/src

# 宿主机端口：前端（容器内 Vite 固定监听 80，只能改宿主机这一侧）
# 绝对不要填 80 —— 80 被飞牛 Web 管理界面占用。
DEV_WEB_PORT=19080

# 宿主机端口：后端 Spring Boot（容器内固定 7007）
DEV_BACKEND_PORT=17007

# 宿主机端口：开发用 MySQL（容器内固定 3306）
# 不要填 3306（容易和别的服务撞），也不要填生产用的 201。
DEV_DB_PORT=13306

# 开发库名（初始化脚本按 surveyking 库建表）
DEV_DB_NAME=surveyking

# 开发库 root 密码。只在本机开发网段用，但仍然别用 123456 这种。
# 生产考试的数据库密码与此无关（生产是 H2，在 /vol2/1000/surveyking/）。
DEV_DB_PASSWORD=dev-only-change-me
