# 旭日云课堂 · NAS 生产目标态（xuri-prod）环境变量模板
#
#   cp .env.example .env && vi .env      # 至少填 DB_PASSWORD 与 SK_CRYPTO_KEY
#   chmod 600 .env                        # 里面是生产密钥，别让同机其他账号读到
#
# ⚠️ 这个 .env 只给 deploy/nas/prod/docker-compose.yml 用，**不会**影响当前
#    手工 docker run 的 surveyking(H2) 容器。切换前请把密钥记进密码管理器。

# ---- 数据库 ----
DB_NAME=surveyking
# MySQL root 密码：见 README「首次建库」；不要用 123456
DB_PASSWORD=请改成强密码

# ---- 应用密钥（两者都必须备份到密码管理器，丢了没法救）----
# SK_CRYPTO_KEY：题库字段加密密钥，必须是 Base64 的 32 字节
#   生成：openssl rand -base64 32
#   丢失后果：已加密的题库字段永久无法解密
SK_CRYPTO_KEY=
# JWT_SECRET：JWT 签名密钥；不填则每次重启随机生成 → 所有人被踢下线
#   生成：openssl rand -base64 48
JWT_SECRET=

# ---- 对外端口（沿用学校现在的 201，避免重新通知全校）----
APP_PORT=201

# ---- 数据根目录（bind mount 的宿主侧；飞牛文件夹备份/快照要覆盖到这里）----
XURI_DATA_DIR=/vol2/1000/xuri/prod

# ---- 镜像（release.sh 会通过环境变量覆盖这两个值；平时不用改）----
# XURI_APP_IMAGE=xuri-classroom:latest
# XURI_WEB_IMAGE=xuri-classroom-web:latest

# ---- JVM 上限（compose 里也有默认值，这里留空就用 -Xmx768m）----
# JAVA_OPTS=-Xmx768m
