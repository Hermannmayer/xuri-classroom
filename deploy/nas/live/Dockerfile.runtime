# =============================================================================
# 旭日云课堂 · live 后端运行时镜像（只做一次）
#
# 为什么不用仓库根目录的 Dockerfile：
#   那份 Dockerfile 是「多阶段从源码构建生产镜像」，每次改后端都要重新
#   npm ci + gradle build，8GB 的飞牛 NAS 上要几分钟。live 模式要的是
#   「编译一次、重启一下」，所以这里只准备一个带 curl 的 JRE 底座，
#   jar 通过 bind mount 挂进来，改完只重启容器。
#
# 构建（只需一次）：
#   docker build -f deploy/nas/live/Dockerfile.runtime -t xuri-runtime:8 .
# 也可以直接：
#   bash scripts/nas/live-bootstrap.sh
# =============================================================================

FROM eclipse-temurin:8-jre-alpine

# 时区 + curl（容器健康检查 / 手工排查都要用；基础镜像里没有）
RUN apk add --no-cache tzdata curl \
    && cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone

WORKDIR /app
ENV TZ=Asia/Shanghai

# 端口与仓库 Dockerfile 保持一致，nginx 侧不用改
EXPOSE 7007

# jar 由 compose 以 bind mount 方式挂到 /app/app.jar
ENTRYPOINT ["java", "-jar", "/app/app.jar", "--server.port=7007"]
