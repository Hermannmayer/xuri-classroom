# 复制为 .env 后使用（docker compose 自动读取）
# 由 scripts/nas/live-bootstrap.sh 或 scripts/nas/migrate/04-import.sh 自动生成也可以

# ---- 数据库 ----
DB_NAME=surveyking
DB_PASSWORD=change-me
SK_CRYPTO_KEY=change-me-base64-32bytes
JWT_SECRET=change-me-base64-48bytes

# ---- 端口 ----
# 201 = Lucky 反代的转发目标（实测 Lucky 自己监听 200 → 转发 201）
APP_PORT=201
# 1201 = 直连调试口，绕过反代用
APP_EXTRA_PORT=1201

# ---- 路径 ----
XURI_SRC=/vol2/1000/xuri/src/work
XURI_DATA_DIR=/vol2/1000/xuri/live
XURI_BUILD_DIR=/vol2/1000/xuri/live/build

# ---- 运行时 ----
XURI_RUNTIME_IMAGE=xuri-runtime:8
JAVA_OPTS=-Xmx768m
# 首次 npm ci 的镜像源；想用官方源就注释掉
NPM_REGISTRY=https://registry.npmmirror.com
