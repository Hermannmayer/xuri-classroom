# 复制为 .env 后使用（docker compose 自动读取）
# 由 scripts/nas/live-bootstrap.sh 或 scripts/nas/migrate/04-import.sh 自动生成也可以

# ---- 数据库 ----
DB_NAME=surveyking
DB_PASSWORD=change-me
SK_CRYPTO_KEY=change-me-base64-32bytes
JWT_SECRET=change-me-base64-48bytes

# ---- 端口 ----
# 201 = Lucky 反代的转发目标（实测 Lucky 自己监听 200 → 转发 201）
APP_PORT=201
# 1201 = 直连调试口，绕过反代用
APP_EXTRA_PORT=1201

# ---- 路径 ----
XURI_SRC=/vol2/1000/xuri/src/work
XURI_DATA_DIR=/vol2/1000/xuri/live
XURI_BUILD_DIR=/vol2/1000/xuri/live/build

# ---- 更新提示 ----
# 两种来源二选一，配了 UPDATE_MANIFEST_URL 就优先用它：
#   1) 自建清单（返回 {"version","notes","url","publishedAt"} 的 JSON）
#   2) GitHub Releases（下面的 UPDATE_GITHUB_REPO）
UPDATE_MANIFEST_URL=

# GitHub 仓库（owner/repo）；留空则关闭检查。
UPDATE_GITHUB_REPO=Hermannmayer/xuri-classroom
# GitHub API 前缀；国内连不上 api.github.com 时可换兼容镜像
# （接口路径保持一致：<base>/repos/<repo>/releases/latest）
UPDATE_GITHUB_API_BASE=https://api.github.com
# 服务端缓存小时数：默认 24。GitHub 未认证接口限流 60 次/小时/IP，
# 一天查一次足够；只有管理员能看到提示，不会打扰学员。
UPDATE_CHECK_INTERVAL_HOURS=24
# 允许应用内一键更新：应用写入 build/app.jar 后退出，Docker 自动重启新版本
UPDATE_APPLY_ENABLED=true
# 可选：GitHub 资产域不可达时的下载前缀，例如 https://ghfast.top/
UPDATE_DOWNLOAD_PROXY=

# ---- 运行时 ----
XURI_RUNTIME_IMAGE=xuri-runtime:25
JAVA_OPTS=-Xmx768m
# 首次 npm ci 的镜像源；想用官方源就注释掉
NPM_REGISTRY=https://registry.npmmirror.com