# 复制为 .env 后按需修改（docker compose 会自动读取）
# 数据库
DB_NAME=surveyking
DB_PASSWORD=change-me-请改成强密码

# 题库字段加密密钥（必须是 Base64 编码的 32 字节；请自行生成并妥善备份）
# PowerShell 生成：$b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# SK_CRYPTO_KEY=在这里填入生成值

# 对外端口：宿主机发布端口（容器内 nginx 固定 80）。
# 默认 9527，四位数、避开服务器上常见的 80/8080/3000。前面挂反向代理时改这里即可。
APP_PORT=9527
