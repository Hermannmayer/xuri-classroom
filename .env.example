# 复制为 .env 后按需修改（docker compose 会自动读取同目录的 .env）
# 默认编排 docker-compose.yml 只拉 GHCR 预构建镜像，不编译；从源码编译用 docker-compose.build.yml。

# 对外端口（宿主机 -> 容器 8080）
APP_PORT=8080

# ------ 数据库 ------
DB_NAME=surveyking
# 注意：mysql 官方镜像不允许 MYSQL_USER=root，这里保持非 root 账号
DB_USER=xuri
# 必填：db 容器首次初始化与 app 连接共用这个密码
DB_PASSWORD=change-me

# ------ 安全 ------
# JWT 签名密钥，生成：openssl rand -base64 48
JWT_SECRET=change-me

# ------ 镜像 ------
# GHCR tag，不带 v；生产环境建议固定版本（例如 2.4.3），方便回滚
VERSION=latest

# 可选：镜像名（不含 tag），用于国内镜像源
# XURI_IMAGE=ghcr.nju.edu.cn/hermannmayer/xuri-classroom

# 可选：init-mysql.sql 路径（默认指向仓库内的初始化脚本，仅首次空库启动时执行）
# INIT_SQL_FILE=./server/rdbms/src/main/resources/scripts/init-mysql.sql

# 可选：JVM 堆上限（4GB 内存用 -Xmx768m，8GB 可用 -Xmx1536m）
# JAVA_OPTS=-Xmx768m
