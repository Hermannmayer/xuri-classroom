<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- S2-5：SQL 由 Mapper 方法上的注解原样迁移过来，语句文本与语义不变；statement id = 方法名。 -->
<mapper namespace="cn.surveyking.server.mapper.DeptRoleMapper">
    <delete id="deleteByDeptId">
        DELETE FROM t_dept_role WHERE dept_id = #{deptId}
    </delete>

    <delete id="deleteByRoleId">
        DELETE FROM t_dept_role WHERE role_id = #{roleId}
    </delete>

</mapper>
