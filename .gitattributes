# 上游构建产物与自动生成的数据：不计入语言统计，别在 diff 里刷屏
frontend-recon/web/**            linguist-vendored
frontend-recon/modules3/**       linguist-vendored
frontend-recon/extract/**        linguist-generated
frontend-recon/recovered/_reference/** linguist-vendored

# 逆向产物统一 LF，避免 Windows 的 CRLF 抖动（只作用于本目录）
frontend-recon/** text=auto eol=lf

# 压缩产物不要试图 diff
frontend-recon/web/*.js  -diff
frontend-recon/web/*.css -diff

# 要在 Linux（NAS）上直接执行的脚本/配置：强制 LF。
# 起因：在 Windows 上编辑过 .sh 后，CRLF 会让远端 bash 报
#   bash: line N: $'\r': command not found
# 这条能兜住，不需要每次手工 sed。
*.sh        text eol=lf
.githooks/commit-msg text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sql       text eol=lf
Dockerfile* text eol=lf
.gitattributes text eol=lf
